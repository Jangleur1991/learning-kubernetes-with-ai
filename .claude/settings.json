{
  "permissions": {
    "allow": [
      "Bash(kubectl get:*)",
      "Bash(kubectl describe:*)",
      "Bash(kubectl logs:*)",
      "Bash(kubectl explain:*)",
      "Bash(kubectl api-resources:*)",
      "Bash(kubectl config current-context)",
      "Bash(kubectl config get-contexts:*)",
      "Bash(kubectl config view:*)",
      "Bash(kubectl top:*)",
      "Bash(kubectl wait:*)",
      "Bash(kubectl rollout status:*)",
      "Bash(./tests/rules/run-all.sh)",
      "Bash(./tests/rules/*)",
      "Bash(./labs/*/verify.sh)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/tests/hooks/guided-mode-guard.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/tests/hooks/detect-solution-leak.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/tests/hooks/verify-kube-context.sh\""
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/tests/hooks/protect-learner-implementation.sh\""
          }
        ]
      }
    ]
  }
}
